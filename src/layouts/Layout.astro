---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'ivancidev — Full Stack Developer',
  description = 'Blog personal de desarrollo web. Artículos sobre React, Next.js, TypeScript, Node.js y más.',
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://ivancidev-blog.vercel.app');
const pageTitle = title === 'ivancidev — Full Stack Developer'
  ? title
  : `${title} | ivancidev`;
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <meta name="keywords" content="Next.js, React, TypeScript, Full Stack, Developer, Blog" />
  <meta name="author" content="ivancidev" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="ivancidev" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={image} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@ivancidev" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
</head>
<body class="bg-[#0a0a0a] text-[#f0f0f0] min-h-screen flex flex-col antialiased">
  <Navbar />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
