---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'ivancidev — Full Stack Developer',
  description = 'Blog personal de desarrollo web. Artículos sobre Astro, React, TypeScript, Node.js y más.',
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://ivancidev-blog.vercel.app');
const pageTitle = title === 'ivancidev — Full Stack Developer'
  ? title
  : `${title} | ivancidev`;
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dvzddtmwg/image/upload/w_64,h_64,c_fill,g_face,r_max/v1775436535/66ac3488-519d-44fc-b836-6433a4d321aa_qesck0.png" />
  <meta name="keywords" content="Astro, React, TypeScript, Full Stack, Developer, Blog" />
  <meta name="author" content="ivancidev" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="ivancidev" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={image} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@ivancidev" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
</head>
<body class="bg-[#05080f] text-[#f0f0f0] min-h-screen flex flex-col antialiased">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:font-semibold focus:rounded-lg focus:text-sm"
  >
    Saltar al contenido
  </a>
  <Navbar />
  <main id="main-content" tabindex="-1" class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
<script>
  import AOS from 'aos';
  AOS.init({ once: true, duration: 650, easing: 'ease-out-cubic', offset: 60 });
</script>
</html>
