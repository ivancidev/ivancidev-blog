---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const allPosts = await getCollection('blog');
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout>

  <!-- HERO -->
  <section class="relative w-full overflow-hidden pt-20 pb-28">
    <div class="absolute inset-0 bg-gradient-to-br from-[#07101f] via-[#05080f] to-[#05080f]" />
    <div class="absolute top-0 right-0 w-[700px] h-[700px] bg-accent/15 rounded-full blur-[160px] pointer-events-none" />
    <div class="absolute top-10 left-0 w-96 h-96 bg-accent/8 rounded-full blur-[100px] pointer-events-none" />
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-32 bg-gradient-to-t from-[#05080f] to-transparent pointer-events-none" />

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-10 lg:gap-12 items-center">

        <!-- Text -->
        <div class="order-2 lg:order-1">
          <h1
            class="text-5xl sm:text-6xl font-bold tracking-tight mb-6 leading-[1.1]"
            data-aos="fade-up"
            data-aos-delay="80"
          >
            <span class="block text-[#7a8fb5] text-3xl sm:text-4xl font-medium mb-1">Hola, soy</span>
            <span class="block bg-gradient-to-r from-[#93c5fd] via-accent to-[#60a5fa] bg-clip-text text-transparent pb-1">ivancidev</span>
            <span class="block text-[#4a6494] text-3xl sm:text-4xl font-semibold mt-1">Full Stack · AI Automation</span>
          </h1>

          <p
            class="text-[#6b80a8] text-base sm:text-lg leading-relaxed mb-10 max-w-lg"
            data-aos="fade-up"
            data-aos-delay="160"
          >
            Construyo productos web con
            <span class="text-[#a8bcd8] font-medium"> React</span>,
            <span class="text-[#a8bcd8] font-medium"> NestJS</span> y
            <span class="text-[#a8bcd8] font-medium"> Next.js</span>, e implemento
            <span class="text-[#a8bcd8] font-medium"> automatizaciones con IA</span>.
            Escribo sobre lo que aprendo para ayudar a otros devs a crecer más rápido.
          </p>

          <div class="flex flex-wrap items-center gap-3" data-aos="fade-up" data-aos-delay="240">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-semibold text-sm rounded-xl hover:bg-accent-hover hover:scale-[1.03] transition-all duration-200"
            >
              Leer el Blog
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/about"
              class="inline-flex items-center gap-2 px-5 py-3 text-[#8ba3c7] hover:text-[#c8d8f0] bg-[#0d1e35] hover:bg-[#1a2d4a] text-sm rounded-xl transition-all duration-200 font-medium"
            >
              Sobre mí
            </a>
            <a
              href="https://github.com/ivancidev"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-[#4a6494] hover:text-[#8ba3c7] transition-colors font-mono"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              @ivancidev
            </a>
          </div>
        </div>

        <!-- Photo -->
        <div class="order-1 lg:order-2 flex justify-center" data-aos="fade-left" data-aos-delay="100">
          <div class="photo-wrapper relative w-64 sm:w-72 lg:w-[320px] h-[360px] sm:h-[400px] lg:h-[420px]">
            <div class="photo-glow absolute -inset-6 bg-accent/25 blur-[80px] rounded-3xl" />
            <div class="relative h-full rounded-3xl overflow-hidden border border-accent/20 shadow-[0_0_60px_rgba(96,165,250,0.2)]">
              <img
                src="https://res.cloudinary.com/dvzddtmwg/image/upload/v1775436535/66ac3488-519d-44fc-b836-6433a4d321aa_qesck0.png"
                alt="ivancidev — Full Stack Developer"
                width="400" height="520"
                class="w-full h-full object-cover object-top"
                loading="eager"
              />
              <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-[#07101f]/60 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-[#07101f] via-[#07101f]/75 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-5">
                <p class="font-mono text-xs text-accent/70 mb-3">
                  <span class="text-accent">const</span> dev = <span class="text-[#93c5fd]">"full-stack"</span>;
                </p>
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#07101f]/80 border border-accent/20 backdrop-blur-sm">
                    <span class="w-2 h-2 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.9)]" aria-hidden="true" />
                    <span class="text-[10px] font-mono text-[#7a8fb5]">online</span>
                  </span>
                  <span class="text-[10px] font-mono text-accent/40">@ivancidev</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- REST -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <!-- STATS — card contenedor, sin líneas flotantes -->
    <section class="mb-16" data-aos="fade-up">
      <div class="grid grid-cols-3 gap-px bg-[#0d1e35] rounded-2xl overflow-hidden">
        {[
          { value: `${allPosts.length}+`, label: "Artículos" },
          { value: "10+", label: "Proyectos & tools" },
          { value: "2+", label: "Años de exp." },
        ].map((stat) => (
          <div class="bg-[#07101f] text-center py-8 px-4 hover:bg-[#091628] transition-colors">
            <div class="text-3xl sm:text-4xl font-bold font-mono text-accent mb-2">{stat.value}</div>
            <div class="text-xs text-[#4a6494] tracking-wide uppercase">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- FEATURED POSTS -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6" data-aos="fade-up">
        <div>
          <h2 class="text-xl font-bold text-[#e2eeff]">Últimos artículos</h2>
          <p class="text-sm text-[#4a6494] mt-0.5">Lo que he estado aprendiendo</p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-sm font-medium text-[#4a6494] hover:text-accent transition-colors duration-200"
        >
          Ver todos
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="space-y-3">
        {featuredPosts.map((post, i) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex items-center gap-5 p-5 rounded-2xl bg-[#080f1c] border border-[#1a2540] hover:border-accent/35 hover:bg-[#0a1425] transition-all duration-200"
            data-aos="fade-up"
            data-aos-delay={i * 70}
          >
            <!-- Número grande decorativo -->
            <span class="hidden sm:block text-5xl font-bold font-mono text-[#0d1e35] group-hover:text-[#1a3158] transition-colors select-none shrink-0 leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>

            <!-- Contenido -->
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-[#c8d8f0] group-hover:text-accent transition-colors text-base mb-1 truncate">
                {post.data.title}
              </h3>
              <p class="text-sm text-[#4a6494] line-clamp-1 mb-3 leading-relaxed">
                {post.data.excerpt}
              </p>
              <div class="flex items-center gap-2 text-xs font-mono text-[#2d4268]">
                <span>{post.data.date}</span>
                <span class="text-[#1a2d4a]">·</span>
                <span>{post.data.readTime}</span>
              </div>
            </div>

            <!-- Flecha -->
            <svg class="w-4 h-4 shrink-0 text-[#2d4268] group-hover:text-accent group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-24" data-aos="fade-up">
      <div class="relative p-8 sm:p-10 rounded-2xl bg-[#080f1c] overflow-hidden">
        <div class="absolute top-0 right-0 w-72 h-72 bg-accent/15 rounded-full blur-3xl pointer-events-none" />
        <div class="absolute bottom-0 left-0 w-56 h-56 bg-accent/8 rounded-full blur-2xl pointer-events-none" />
        <div class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#c8d8f0] mb-2">¿Tienes un proyecto en mente?</h2>
            <p class="text-[#4a6494] max-w-sm leading-relaxed">
              Estoy disponible para colaboraciones o simplemente para charlar sobre tech.
            </p>
          </div>
          <a
            href="mailto:herlanherbas@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-accent to-accent-hover text-white font-semibold text-sm rounded-xl shadow-[0_0_20px_rgba(96,165,250,0.35)] hover:shadow-[0_0_40px_rgba(96,165,250,0.6)] hover:scale-[1.03] transition-all duration-200 shrink-0"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Contáctame
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .photo-wrapper {
    animation: float 6s ease-in-out infinite;
  }
  .photo-glow {
    animation: glow-pulse 4s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }
  @keyframes glow-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.08); }
  }
</style>
