---
import Layout from '@/layouts/Layout.astro';
import { devTools, devToolCategories } from '@/lib/data';

const grouped = devToolCategories.map((cat) => ({
  ...cat,
  tools: devTools.filter((t) => t.category === cat.id),
}));
---

<Layout title="Dev Toolkit" description="Las herramientas, extensiones y apps que uso a diario para desarrollar.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

    <!-- Header -->
    <div class="mb-14" data-aos="fade-up">
      <div class="flex items-center gap-2 text-xs font-mono text-[#555] mb-4">
        <a href="/" class="hover:text-[#888] transition-colors">home</a>
        <span>/</span>
        <span class="text-[#888]">tools</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#f0f0f0] mb-3">Mi Dev Toolkit</h1>
      <p class="text-[#555] max-w-lg leading-relaxed">
        Las herramientas, extensiones y aplicaciones que uso a diario. Cada una elegida por productividad,
        calidad o porque simplemente hace la vida más fácil.
      </p>

      <!-- Legend -->
      <div class="flex items-center gap-2 mt-5 text-xs font-mono text-[#444]">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#f97316]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Favorito
        </span>
        <span class="text-[#333]">—</span>
        <span>tool que más recomiendo</span>
      </div>
    </div>

    <!-- Categories -->
    {grouped.map((cat, catIdx) => cat.tools.length > 0 && (
      <section class="mb-12" data-aos="fade-up" data-aos-delay={catIdx * 60}>
        <!-- Category header -->
        <div class="flex items-center gap-3 mb-5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono font-semibold text-[#f97316] tracking-widest uppercase">
              {cat.label}
            </span>
            <span class="text-[10px] font-mono text-[#333]">— {cat.tools.length}</span>
          </div>
          <div class="flex-1 h-px bg-[#1f1f1f]" />
        </div>

        <!-- Tools grid -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {cat.tools.map((tool, i) => (
            <div
              class="group relative flex gap-3 p-4 rounded-xl border border-[#1f1f1f] hover:border-[#f97316]/25 bg-[#111]/40 hover:bg-[#111] transition-all duration-200"
              data-aos="fade-up"
              data-aos-delay={catIdx * 40 + i * 50}
            >
              <!-- Accent left bar on hover -->
              <div class="absolute left-0 top-3 bottom-3 w-[2px] rounded-full bg-[#f97316] opacity-0 group-hover:opacity-100 transition-opacity duration-200" />

              <!-- Icon -->
              <div
                class="shrink-0 w-9 h-9 rounded-lg flex items-center justify-center text-white text-xs font-bold font-mono select-none shadow-sm"
                style={`background-color: ${tool.color}22; border: 1px solid ${tool.color}40; color: ${tool.color};`}
              >
                {tool.initials}
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 mb-0.5">
                  <span class="text-sm font-semibold text-[#f0f0f0] group-hover:text-[#f97316] transition-colors truncate">
                    {tool.name}
                  </span>
                  {tool.favorite && (
                    <svg class="w-3 h-3 text-[#f97316] shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  )}
                </div>
                <p class="text-[11px] text-[#555] leading-relaxed line-clamp-2">{tool.description}</p>
              </div>

              <!-- External link -->
              {tool.url && (
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity text-[#555] hover:text-[#f97316]"
                  aria-label={`Abrir ${tool.name}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Footer note -->
    <p class="text-center text-xs font-mono text-[#333] mt-8" data-aos="fade-up">
      Lista actualizada en 2025 · Siempre explorando nuevas herramientas
    </p>

  </div>
</Layout>
