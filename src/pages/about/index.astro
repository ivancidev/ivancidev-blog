---
import Layout from '@/layouts/Layout.astro';
import { stack, socialLinks } from '@/lib/data';
---

<Layout title="About" description="Sobre mí: desarrollador Full Stack especializado en React, Astro y Node.js.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#2d4268] mb-10">
      <a href="/" class="hover:text-accent/60 transition-colors">home</a>
      <span>/</span>
      <span class="text-[#4a6494]">about</span>
    </div>

    <!-- Profile header -->
    <div class="flex items-center gap-5 mb-14" data-aos="fade-up">
      <div class="relative shrink-0">
        <img
          src="https://res.cloudinary.com/dvzddtmwg/image/upload/v1775436535/66ac3488-519d-44fc-b836-6433a4d321aa_qesck0.png"
          alt="ivancidev"
          width="80"
          height="80"
          class="w-20 h-20 rounded-2xl object-cover object-top"
        />
        <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.7)] border-2 border-[#05080f]" />
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-[#e2eeff] mb-1">Ivan Herlan Herbas Zubieta</h1>
        <p class="text-accent/70 font-mono text-sm mb-2">Full Stack Developer · AI Automation</p>
        <div class="flex items-center gap-3 text-xs text-[#2d4268] font-mono flex-wrap">
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Cochabamba, Bolivia
          </span>
          <span class="text-[#1a2d4a]">·</span>
          <span class="text-[#22c55e]">Disponible para remoto</span>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div class="mb-14 p-7 rounded-2xl bg-[#080f1c] border border-[#1a2540]" data-aos="fade-up">
      <h2 class="text-base font-semibold text-[#e2eeff] mb-4">Hola, soy Iván 👋</h2>
      <div class="space-y-3 text-[#4a6494] leading-relaxed text-sm">
        <p>
          Soy Full Stack Developer de Cochabamba, Bolivia, especializado en construir
          productos web modernos e implementar
          <span class="text-[#8ba3c7] font-medium"> automatizaciones con IA</span>.
          Trabajo con el ecosistema <span class="text-[#8ba3c7] font-medium">TypeScript/JavaScript</span>
          — React y Next.js en el frontend, NestJS y Node.js en el backend.
        </p>
        <p>
          Me apasiona integrar herramientas de IA como <span class="text-[#8ba3c7] font-medium">n8n, OpenAI y Claude</span>
          para crear workflows que ahorran tiempo real. También construyo apps móviles con React Native
          y diseño APIs robustas con Docker y PostgreSQL.
        </p>
        <p>
          Este blog es mi espacio para documentar lo que aprendo y compartirlo con la comunidad dev.
          Actualmente abierto a proyectos freelance y oportunidades de trabajo remoto.
        </p>
      </div>
    </div>

    <!-- Tech stack -->
    <div class="mb-14" data-aos="fade-up">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[10px] font-mono font-semibold text-accent tracking-widest uppercase">Tech Stack</span>
        <div class="flex-1 h-px bg-[#1a2540]" />
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {stack.map((group) => (
          <div class="p-5 rounded-2xl bg-[#080f1c] border border-[#1a2540]">
            <h3 class="text-[10px] font-mono font-semibold text-[#2d4268] tracking-widest uppercase mb-3">{group.category}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="text-xs px-2.5 py-1 rounded-lg font-mono text-[#6b80a8] bg-[#0d1e35] hover:text-accent/80 transition-colors cursor-default">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Currently at -->
    <div class="mb-14" data-aos="fade-up">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono font-semibold text-accent tracking-widest uppercase">Actualmente</span>
        <div class="flex-1 h-px bg-[#1a2540]" />
      </div>
      <div class="flex items-center gap-4 p-5 rounded-2xl bg-[#080f1c] border border-[#1a2540]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e] shadow-[0_0_10px_rgba(34,197,94,0.6)] shrink-0" />
        <div>
          <p class="text-sm font-semibold text-[#c8d8f0]">Full Stack Developer <span class="font-mono text-accent/60 text-xs ml-1">@ useTeam</span></p>
          <p class="text-xs font-mono text-[#2d4268] mt-0.5">Jul. 2025 — Presente · En remoto</p>
        </div>
        <a
          href="https://www.linkedin.com/in/herlan-herbas-zubieta/"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-auto text-[11px] font-mono text-[#2d4268] hover:text-accent transition-colors flex items-center gap-1"
        >
          Ver LinkedIn
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Social links -->
    <div class="mb-10" data-aos="fade-up">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[10px] font-mono font-semibold text-accent tracking-widest uppercase">Encuéntrame en</span>
        <div class="flex-1 h-px bg-[#1a2540]" />
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          {
            label: "GitHub", href: socialLinks.github, username: "@ivancidev",
            icon: `<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>`,
          },
          {
            label: "LinkedIn", href: socialLinks.linkedin, username: "ivancidev",
            icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
          },
          {
            label: "Twitter/X", href: socialLinks.twitter, username: "@ivancidev",
            icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
          },
          {
            label: "Email", href: socialLinks.email, username: "Escríbeme",
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
            stroke: true,
          },
        ].map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('mailto') ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class="group flex flex-col items-center gap-2.5 p-4 rounded-2xl bg-[#080f1c] border border-[#1a2540] hover:border-accent/30 hover:bg-[#0a1425] transition-all duration-200"
          >
            <span class="text-[#2d4268] group-hover:text-accent transition-colors">
              {social.stroke ? (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={social.icon} />
              ) : (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" set:html={social.icon} />
              )}
            </span>
            <div class="text-center">
              <p class="text-xs font-semibold text-[#4a6494] group-hover:text-[#c8d8f0] transition-colors">{social.label}</p>
              <p class="text-[11px] text-[#2d4268] font-mono">{social.username}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="relative p-7 rounded-2xl bg-[#080f1c] border border-accent/15 overflow-hidden" data-aos="fade-up">
      <div class="absolute top-0 right-0 w-48 h-48 bg-accent/10 rounded-full blur-3xl pointer-events-none" />
      <div class="relative flex items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-[#c8d8f0] mb-1">¿Quieres saber más?</p>
          <p class="text-sm text-[#4a6494]">Contáctame directamente.</p>
        </div>
        <a
          href={socialLinks.email}
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-accent to-accent-hover text-white font-semibold text-sm rounded-xl shadow-[0_0_16px_rgba(96,165,250,0.3)] hover:shadow-[0_0_28px_rgba(96,165,250,0.55)] hover:scale-[1.03] transition-all duration-200 shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Contáctame
        </a>
      </div>
    </div>

  </div>
</Layout>
