---
import Layout from '@/layouts/Layout.astro';
import { stack, socialLinks } from '@/lib/data';
---

<Layout title="About" description="Sobre mí: desarrollador Full Stack especializado en React, Astro y Node.js.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#555] mb-12">
      <a href="/" class="hover:text-[#888] transition-colors">home</a>
      <span>/</span>
      <span class="text-[#888]">about</span>
    </div>

    <!-- Profile header -->
    <div class="flex items-start gap-6 mb-12 pb-12 border-b border-[#1f1f1f]">
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#00ff88]/20 to-[#00ccff]/10 border border-[#00ff88]/20 flex items-center justify-center shrink-0">
        <span class="text-2xl font-bold font-mono text-[#00ff88]">iv</span>
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-[#f0f0f0] mb-1">ivancidev</h1>
        <p class="text-[#00ff88] font-mono text-sm mb-3">Full Stack Developer</p>
        <div class="flex items-center gap-2 text-xs text-[#555] font-mono">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Bolivia · Remote
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div class="space-y-4 text-[#888] leading-relaxed mb-14">
      <h2 class="text-lg font-semibold text-[#f0f0f0]">Hola, soy Iván 👋</h2>
      <p>
        Soy un desarrollador Full Stack con más de 2 años de experiencia construyendo
        productos web modernos. Me especializo en el ecosistema
        <span class="text-[#f0f0f0]"> JavaScript/TypeScript</span>, principalmente con
        React, Astro en el frontend y Node.js en el backend.
      </p>
      <p>
        Me apasiona escribir código limpio, crear interfaces de usuario que se sientan
        rápidas y naturales, y compartir lo que aprendo con la comunidad dev.
        Este blog es mi espacio para documentar ese proceso.
      </p>
      <p>
        Actualmente estoy disponible para proyectos freelance y estoy abierto a
        oportunidades de trabajo remoto.
      </p>
    </div>

    <!-- Tech stack -->
    <div class="mb-14">
      <h2 class="text-xs font-mono text-[#555] mb-6">TECH STACK</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {stack.map((group) => (
          <div class="p-4 rounded-xl border border-[#1f1f1f] bg-[#111]/50">
            <h3 class="text-xs font-mono text-[#555] mb-3">{group.category}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="text-xs px-2.5 py-1 rounded-md font-mono text-[#888] bg-[#161616] border border-[#1f1f1f] hover:border-[#333] hover:text-[#f0f0f0] transition-all">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Experience -->
    <div class="mb-14">
      <h2 class="text-xs font-mono text-[#555] mb-6">EXPERIENCIA</h2>
      <div class="space-y-4">
        {[
          {
            role: "Full Stack Developer",
            company: "Freelance",
            period: "2024 — Presente",
            description: "Desarrollo de aplicaciones web con React, Astro y Node.js. Implementación de arquitecturas escalables y APIs RESTful.",
          },
          {
            role: "Frontend Developer",
            company: "Proyectos universitarios",
            period: "2023 — 2024",
            description: "Construcción de interfaces de usuario con React y TypeScript. Integración con APIs y optimización de performance.",
          },
        ].map((exp) => (
          <div class="flex gap-4 p-4 rounded-xl border border-[#1f1f1f] bg-[#111]/30">
            <div class="w-px bg-[#1f1f1f] shrink-0 ml-2 my-1" />
            <div>
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h3 class="font-medium text-[#f0f0f0]">{exp.role}</h3>
                <span class="text-xs text-[#555]">@</span>
                <span class="text-sm text-[#00ff88] font-mono">{exp.company}</span>
              </div>
              <p class="text-xs font-mono text-[#444] mb-2">{exp.period}</p>
              <p class="text-sm text-[#666]">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Social links -->
    <div class="mb-14">
      <h2 class="text-xs font-mono text-[#555] mb-6">ENCUÉNTRAME EN</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          {
            label: "GitHub", href: socialLinks.github, username: "@ivancidev",
            icon: `<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>`,
          },
          {
            label: "LinkedIn", href: socialLinks.linkedin, username: "ivancidev",
            icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
          },
          {
            label: "Twitter/X", href: socialLinks.twitter, username: "@ivancidev",
            icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
          },
          {
            label: "Email", href: socialLinks.email, username: "Escríbeme",
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
            stroke: true,
          },
        ].map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('mailto') ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class="group flex flex-col items-center gap-2 p-4 rounded-xl border border-[#1f1f1f] hover:border-[#00ff88]/30 bg-[#111]/50 hover:bg-[#111] transition-all"
          >
            <span class="text-[#555] group-hover:text-[#00ff88] transition-colors">
              {social.stroke ? (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={social.icon} />
              ) : (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" set:html={social.icon} />
              )}
            </span>
            <div class="text-center">
              <p class="text-xs font-semibold text-[#888] group-hover:text-[#f0f0f0] transition-colors">{social.label}</p>
              <p class="text-[11px] text-[#444] font-mono">{social.username}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="p-6 rounded-xl border border-[#1f1f1f] bg-[#111]/50 flex items-center justify-between gap-4">
      <div>
        <p class="font-medium text-[#f0f0f0] mb-1">¿Quieres saber más?</p>
        <p class="text-sm text-[#555]">Descarga mi CV o contáctame directamente.</p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href={socialLinks.email}
          class="px-4 py-2 text-sm font-medium text-[#888] border border-[#1f1f1f] hover:border-[#333] hover:text-[#f0f0f0] rounded-lg transition-all"
        >
          Email
        </a>
        <a
          href="#"
          class="px-4 py-2 text-sm font-semibold bg-[#00ff88] text-black rounded-lg hover:bg-[#00cc6e] transition-colors"
        >
          Descargar CV
        </a>
      </div>
    </div>

  </div>
</Layout>
