---
import Layout from '@/layouts/Layout.astro';
import { devTools, devToolCategories } from '@/lib/data';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const allTools = devTools;

const groupedTools = devToolCategories.map((cat) => ({
  ...cat,
  tools: allTools.filter((tool) => tool.category === cat.id),
})).filter((g) => g.tools.length > 0);
---

<Layout title={t('tools.title')} description={t('tools.desc')}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">

    <!-- Header -->
    <div class="mb-10" data-aos="fade-up">
      <div class="flex items-center gap-2 text-xs font-mono text-accent/40 mb-5">
        <a href={lang === 'es' ? '/es' : '/'} class="hover:text-accent/70 transition-colors">home</a>
        <span>/</span>
        <span class="text-accent/60">tools</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-[#e2eeff] mb-3 tracking-tight">{t('tools.title')}</h1>
      <p class="text-[#8ba3c7] max-w-lg leading-relaxed">{t('tools.desc')}</p>
    </div>

    <div class="flex gap-10 items-start">

      <!-- Sidebar (desktop) / Top tabs (mobile) -->
      <aside class="w-40 shrink-0 hidden lg:block">
        <div class="sticky top-24 space-y-0.5">
          <button data-filter="all" class="f-btn active w-full text-left px-3 py-2 rounded-lg flex justify-between items-center">
            <span>All</span><span class="count">{allTools.length}</span>
          </button>
          {groupedTools.map(g => (
            <button data-filter={g.id} class="f-btn w-full text-left px-3 py-2 rounded-lg flex justify-between items-center">
              <span>{g.label}</span><span class="count">{g.tools.length}</span>
            </button>
          ))}
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex-1 min-w-0">

        <!-- Mobile tabs (horizontal scroll) -->
        <div class="lg:hidden flex gap-2 overflow-x-auto pb-3 mb-8" style="scrollbar-width:none">
          <button data-filter="all" class="f-btn active shrink-0 px-4 py-1.5 rounded-full text-xs font-mono font-semibold whitespace-nowrap">
            All <span class="count">{allTools.length}</span>
          </button>
          {groupedTools.map(g => (
            <button data-filter={g.id} class="f-btn shrink-0 px-4 py-1.5 rounded-full text-xs font-mono font-semibold whitespace-nowrap">
              {g.label} <span class="count">{g.tools.length}</span>
            </button>
          ))}
        </div>

        <!-- Tool groups — NO data-aos so they're always visible -->
        <div class="space-y-10" id="groups-container" style="min-height: calc(100vh - 320px)">
          {groupedTools.map(g => (
            <div class="t-group" data-group={g.id}>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-mono font-semibold text-accent/60 tracking-widest uppercase">{g.label}</span>
                <span class="text-accent/25 text-xs font-mono">— {g.tools.length}</span>
                <div class="flex-1 h-px bg-accent/10" />
              </div>
              <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-2.5">
                {g.tools.map(tool => (
                  <button
                    class="tool-card group relative flex gap-3 p-3.5 rounded-xl border transition-all duration-200 text-left w-full"
                    data-name={tool.name}
                    data-description={lang === 'en' ? tool.descriptionEn : tool.description}
                    data-url={tool.url ?? ''}
                    data-color={tool.color}
                    data-initials={tool.initials}
                    data-category={tool.category}
                    data-favorite={tool.favorite ? 'true' : 'false'}
                  >
                    <div
                      class="shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-[11px] font-bold font-mono select-none"
                      style={`background:${tool.color}22;color:${tool.color}`}
                    >
                      {tool.initials}
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <span class="text-sm font-semibold text-[#c8d8f0] group-hover:text-accent transition-colors truncate">{tool.name}</span>
                        {tool.favorite && (
                          <svg class="w-3 h-3 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                        )}
                      </div>
                      <p class="text-[11px] text-[#8ba3c7] leading-relaxed line-clamp-2">{lang === 'en' ? tool.descriptionEn : tool.description}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <p class="text-xs font-mono text-[#6b80a8] mt-12">{t('tools.updated')}</p>
      </div>
    </div>
  </div>
</Layout>

<!-- Modal -->
<div id="tool-modal" class="fixed inset-0 z-50 items-end sm:items-center justify-center p-4 hidden" role="dialog" aria-modal="true" data-lang={lang}>
  <div id="modal-backdrop" class="absolute inset-0 bg-[#020509]/80 backdrop-blur-sm"></div>
  <div id="modal-panel" class="relative w-full max-w-md rounded-2xl bg-[#080f1c] border border-[#1a2540] p-6 shadow-[0_0_60px_rgba(0,0,0,0.6)] opacity-0 transition-all duration-300">
    <button id="modal-close" class="absolute top-4 right-4 text-[#6b80a8] hover:text-[#c8d8f0] transition-colors" aria-label="Close">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <div class="flex items-center gap-4 mb-5">
      <div id="modal-icon" class="w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-bold font-mono shrink-0"></div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h2 id="modal-name" class="text-lg font-bold text-[#e2eeff]"></h2>
          <span id="modal-fav" class="hidden">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </span>
        </div>
        <span id="modal-cat" class="text-[11px] font-mono text-accent/60 bg-accent/8 px-2 py-0.5 rounded-md"></span>
      </div>
    </div>
    <p id="modal-desc" class="text-sm text-[#8ba3c7] leading-relaxed mb-6"></p>
    <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-white font-semibold text-sm rounded-xl hover:bg-accent-hover transition-all duration-200 w-full justify-center">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
      {t('tools.visit')}
    </a>
    <div id="modal-nolink" style="display:none" class="text-center text-xs font-mono text-[#6b80a8] mt-4">{t('tools.noLink')}</div>
  </div>
</div>

<style>
  /* Filter buttons — all state via CSS, no Tailwind class swapping */
  .f-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b80a8;
    transition: color 0.15s;
  }
  .f-btn:hover { color: #c8d8f0; }
  .f-btn.active { color: rgb(var(--accent)); }
  .f-btn .count {
    font-size: 0.7rem;
    opacity: 0.45;
  }

  /* Tool card base */
  .tool-card {
    background: #080f1c;
    border-color: #1a2540;
  }
  .tool-card:hover {
    border-color: rgba(var(--accent) / 0.3);
    background: #0a1425;
  }
</style>

<script>
  // ── Filter ──────────────────────────────────────────────────────────────────
  const allBtns = document.querySelectorAll<HTMLButtonElement>('.f-btn');
  const allGroups = document.querySelectorAll<HTMLElement>('.t-group');

  allBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;

      // Active state: remove from all, add to all buttons with same filter value
      allBtns.forEach(b => b.classList.remove('active'));
      document.querySelectorAll<HTMLButtonElement>(`[data-filter="${f}"]`)
        .forEach(b => b.classList.add('active'));

      // Show / hide groups
      allGroups.forEach(g => {
        g.style.display = (f === 'all' || g.dataset.group === f) ? '' : 'none';
      });
    });
  });

  // ── Modal ───────────────────────────────────────────────────────────────────
  const modal   = document.getElementById('tool-modal')!;
  const backdrop = document.getElementById('modal-backdrop')!;
  const panel   = document.getElementById('modal-panel')!;
  const close   = document.getElementById('modal-close')!;
  const icon    = document.getElementById('modal-icon')!;
  const name    = document.getElementById('modal-name')!;
  const cat     = document.getElementById('modal-cat')!;
  const desc    = document.getElementById('modal-desc')!;
  const link    = document.getElementById('modal-link') as HTMLAnchorElement;
  const nolink  = document.getElementById('modal-nolink')!;
  const fav     = document.getElementById('modal-fav')!;

  const isEn = modal.dataset.lang === 'en';
  const catLabel: Record<string, string> = isEn
    ? { Editor:'Editor', Extensions:'Extensions', CLI:'CLI & Runtime', Browser:'Browser', Design:'Design', Productivity:'Productivity', AI:'AI & Automation' }
    : { Editor:'Editor', Extensions:'Extensiones', CLI:'CLI & Runtime', Browser:'Navegador', Design:'Diseño', Productivity:'Productividad', AI:'IA & Automatización' };

  function openModal(card: HTMLElement) {
    const color = card.dataset.color!;
    icon.style.background = color + '22';
    icon.style.color = color;
    icon.textContent = card.dataset.initials!;
    name.textContent = card.dataset.name!;
    cat.textContent  = catLabel[card.dataset.category!] ?? card.dataset.category!;
    desc.textContent = card.dataset.description!;
    fav.classList.toggle('hidden', card.dataset.favorite !== 'true');
    const url = card.dataset.url!;
    link.style.display   = url ? '' : 'none';
    nolink.style.display = url ? 'none' : '';
    if (url) link.href   = url;
    modal.style.display  = 'flex';
    requestAnimationFrame(() => panel.classList.add('opacity-100'));
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    panel.classList.remove('opacity-100');
    setTimeout(() => { modal.style.display = 'none'; document.body.style.overflow = ''; }, 250);
  }

  document.querySelectorAll<HTMLElement>('.tool-card').forEach(c => c.addEventListener('click', () => openModal(c)));
  close.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
