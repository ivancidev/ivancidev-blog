---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-50 border-b border-[#1f1f1f] bg-[#0a0a0a]/80 backdrop-blur-md transition-all duration-300">
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="w-7 h-7 rounded-md bg-[#f97316] flex items-center justify-center text-black font-bold text-sm font-mono group-hover:scale-110 group-hover:shadow-[0_0_12px_rgba(249,115,22,0.5)] transition-all duration-200">
        iv
      </span>
      <span class="font-mono font-semibold text-[#f0f0f0] text-sm hidden sm:block">ivancidev</span>
      <span class="font-mono text-[#555] text-sm hidden sm:block">/dev</span>
    </a>

    <!-- Nav links -->
    <ul class="flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'relative px-3 py-1.5 text-sm rounded-md transition-all duration-200 font-medium block',
              isActive(link.href) ? 'text-[#f97316]' : 'text-[#888] hover:text-[#f0f0f0]',
            ]}
          >
            {isActive(link.href) && (
              <span class="absolute inset-0 rounded-md bg-[#f97316]/[.08] border border-[#f97316]/20" />
            )}
            <span class="relative">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- GitHub CTA -->
    <a
      href="https://github.com/ivancidev"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:flex items-center gap-2 px-3 py-1.5 text-xs font-mono text-[#888] hover:text-[#f97316] border border-[#1f1f1f] hover:border-[#f97316]/40 rounded-md transition-all duration-200"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
      </svg>
      GitHub
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 24) {
      header?.style.setProperty('box-shadow', '0 4px 32px rgba(249,115,22,0.07)');
      header?.style.setProperty('border-bottom-color', '#2a2a2a');
      header?.style.setProperty('background-color', 'rgba(10,10,10,0.95)');
    } else {
      header?.style.removeProperty('box-shadow');
      header?.style.setProperty('border-bottom-color', '#1f1f1f');
      header?.style.setProperty('background-color', 'rgba(10,10,10,0.8)');
    }
  }, { passive: true });
</script>
