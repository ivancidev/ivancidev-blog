---
import { getLangFromUrl, useTranslations, getAlternateLangUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altUrl = getAlternateLangUrl(Astro.url);
const pathname = Astro.url.pathname;

const navLinks = [
  { key: 'nav.home' as const, href: lang === 'es' ? '/es' : '/' },
  { key: 'nav.blog' as const, href: lang === 'es' ? '/es/blog' : '/blog' },
  { key: 'nav.tools' as const, href: lang === 'es' ? '/es/tools' : '/tools' },
  { key: 'nav.about' as const, href: lang === 'es' ? '/es/about' : '/about' },
];

function isActive(href: string) {
  if (href === '/' || href === '/es') return pathname === href;
  return pathname.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-[#05080f]/85 backdrop-blur-md transition-all duration-300">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href={lang === 'es' ? '/es' : '/'} class="flex items-center gap-2.5 group">
      <div class="relative w-10 h-10 shrink-0">
        <img
          src="https://res.cloudinary.com/dvzddtmwg/image/upload/v1775436535/66ac3488-519d-44fc-b836-6433a4d321aa_qesck0.png"
          alt="ivancidev"
          width="40"
          height="40"
          class="w-10 h-10 rounded-full object-cover object-top group-hover:ring-2 group-hover:ring-accent/50 transition-all duration-200"
        />
      </div>
      <span class="font-semibold text-[#c8d8f0] text-sm hidden sm:block group-hover:text-accent transition-colors duration-200">ivancidev</span>
    </a>

    <!-- Nav links -->
    <ul class="flex items-center gap-0.5">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'relative px-3 py-1.5 text-sm rounded-lg transition-all duration-200 font-medium block',
              isActive(link.href)
                ? 'text-accent bg-accent/8'
                : 'text-[#8ba3c7] hover:text-[#e2eeff] hover:bg-accent/8',
            ]}
          >
            {t(link.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side: Lang toggle + GitHub -->
    <div class="flex items-center gap-1">
      <!-- Language toggle -->
      <a
        href={altUrl}
        class="hidden sm:flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono font-semibold text-[#8ba3c7] hover:text-accent hover:bg-accent/8 rounded-lg transition-all duration-200"
        title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
        </svg>
        {t('lang.toggle')}
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/ivancidev"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono text-[#8ba3c7] hover:text-accent hover:bg-accent/8 rounded-lg transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        {t('nav.github')}
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 24) {
      header?.style.setProperty('box-shadow', '0 1px 0 rgba(30,45,69,0.8)');
      header?.style.setProperty('border-bottom-color', '#1a2540');
      header?.style.setProperty('background-color', 'rgba(5,8,15,0.97)');
    } else {
      header?.style.removeProperty('box-shadow');
      header?.style.setProperty('border-bottom-color', 'transparent');
      header?.style.setProperty('background-color', 'rgba(5,8,15,0.85)');
    }
  }, { passive: true });
</script>
